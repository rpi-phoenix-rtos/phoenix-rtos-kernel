/* CTF 1.8 */
typealias integer { size = 8; align = 8; signed = true; } := i8;
typealias integer { size = 8; align = 8; signed = false; } := u8;
typealias integer { size = 16; align = 8; signed = false; } := u16;
typealias integer { size = 32; align = 8; signed = false; } := u32;
typealias integer { size = 32; align = 8; signed = true; } := i32;
typealias integer { size = 64; align = 8; signed = false; } := u64;
typealias integer { size = 8; align = 8; signed = false; encoding = ASCII; } := str;

trace {
	major = 1;
	minor = 8;
	byte_order = le;
};

clock {
	name = monotonic;
	freq = 1000000;
};


stream {
	event.header := struct {
		u32 timestamp;
		u8 id;
	};
	packet.context := struct {
		u8 cpu;
	};
};

event {
	name = interrupt_enter;
	id = 0x20;
	fields := struct {
		u8 irq;
	};
};

event {
	name = interrupt_exit;
	id = 0x21;
	fields := struct {
		u8 irq;
	};
};

event {
	name = thread_scheduling;
	id = 0x22;
	fields := struct {
		u16 tid;
	};
};

event {
	name = thread_preempted;
	id = 0x23;
	fields := struct {
		u16 tid;
	};
};

event {
	name = thread_enqueued;
	id = 0x24;
	fields := struct {
		u16 tid;
	};
};

event {
	name = thread_waking;
	id = 0x25;
	fields := struct {
		u16 tid;
	};
};

event {
	name = thread_create;
	id = 0x26;
	fields := struct {
		u16 pid;
		u16 tid;
		i8 prio;
		str name[128];
	};
};

event {
	name = thread_end;
	id = 0x27;
	fields := struct {
		u16 pid;
		u16 tid;
	};
};

event {
	name = syscall_enter;
	id = 0x28;
	fields := struct {
		u8 n;
		u16 tid;
	};
};

event {
	name = syscall_exit;
	id = 0x29;
	fields := struct {
		u8 n;
		u16 tid;
	};
};

/* TODO: remove cpu fields from sched events - they are redundant due to stream event context*/
event {
	name = sched_enter;
	id = 0x2a;
	fields := struct {
		u8 cpu;
	};
};

event {
	name = sched_exit;
	id = 0x2b;
	fields := struct {
		u8 cpu;
	};
};

event {
	name = lock_name;
	id = 0x2c;
	fields := struct {
		u32 lid;
		str name[16];
	};
};

event {
	name = lock_set_enter;
	id = 0x2d;
	fields := struct {
		u16 tid;
		u32 lid;
	};
};


event {
	name = lock_set_acquired;
	id = 0x2e;
	fields := struct {
		u16 tid;
		u32 lid;
	};
};

event {
	name = lock_set_exit;
	id = 0x2f;
	fields := struct {
		u16 tid;
		u32 lid;
	};
};

event {
	name = lock_clear;
	id = 0x30;
	fields := struct {
		u16 tid;
		u32 lid;
	};
};

event {
	name = thread_priority;
	id = 0x31;
	fields := struct {
		u16 tid;
		/* TODO: rename to prio to stay consistent with thread_create and process_exec */
		i8 priority;
	};
};

event {
	name = process_kill;
	id = 0x32;
	fields := struct {
		u16 pid;
	};
};

event {
	name = process_exec;
	id = 0x33;
	fields := struct {
		u16 pid;
		u16 tid;
		i8 prio;
		str name[128];
	};
};

/*
 * Profiling events. A frame list is a frame-pointer chain of return addresses, innermost first.
 * The user part of thread_sample and thread_wait is the user context the thread runs in (sample in
 * user mode) or entered the kernel with (pc = 0 for a kernel thread), the frame-pointer chain of its
 * stack, and optionally the top of its stack: nstack words from sp.
 */
event {
	name = thread_sample;
	id = 0x40;
	fields := struct {
		u16 tid;
		/* 0: user, 1: kernel on behalf of a process, 2: kernel thread */
		u8 mode;
		/* bit 0 (skid): kpc follows an instruction that unmasks interrupts, the timer interrupt
		 * was held off until then: the work was done by the code before it (klr, kframes) */
		u8 kflags;
		u64 kpc;
		u64 klr;
		/* mode 1: the syscall the thread is in, 0xffff: none */
		u16 syscall;
		/* mode 1, no syscall: the exception the thread entered with (ESR.EC; 0x24: data abort,
		 * 0x20: instruction abort), 0xff: none; kfar: its fault address */
		u8 eclass;
		u64 kfar;
		u8 nkframes;
		u64 kframes[nkframes];
		u64 pc;
		u64 lr;
		u64 sp;
		u64 fp;
		u8 nframes;
		u64 frames[nframes];
		u16 nstack;
		u64 stack[nstack];
	};
};

event {
	name = thread_wait;
	id = 0x41;
	fields := struct {
		u16 tid;
		/*
		 * bit 0: the thread was already waiting when the trace started
		 * bit 1: written when the wait ended (perf_trace_cfg_t.waitMinUs): it began blocked us
		 *        before the event
		 * bit 2: written when the trace stopped, the thread still waiting
		 * bit 3: where the thread's previous recorded wait was: kframes, frames and stack left out
		 *        (nkframes = nframes = nstack = 0), see that wait
		 * A deferred wait shorter than perf_trace_cfg_t.waitStackMinUs has nstack = 0.
		 */
		u8 flags;
		/* wait queue (kernel address cropped to 32 bits), 0: sleep */
		u32 queue;
		/* us left until the deadline when the wait began, 0: none */
		u32 timeout;
		/* us the wait lasted (bits 1, 2), 0: written when it began */
		u32 blocked;
		/* the syscall the thread waits in, 0xffff: not known */
		u16 syscall;
		/* syscall arguments */
		u64 args[4];
		u8 nkframes;
		u64 kframes[nkframes];
		u64 pc;
		u64 lr;
		u64 sp;
		u64 fp;
		u8 nframes;
		u64 frames[nframes];
		u16 nstack;
		u64 stack[nstack];
	};
};

event {
	name = thread_wakeup;
	id = 0x42;
	fields := struct {
		u16 tid;
		/* thread that woke tid, 0: none (timer) */
		u16 waker;
		/* 0: explicit wakeup, 1: timeout, 2: signal or exit request, 3: lock handed over */
		u8 cause;
	};
};

/* mid: kernel address of the message (cropped to 32 bits), unique while it is in flight */
event {
	name = msg_send;
	id = 0x43;
	fields := struct {
		u16 tid;
		u32 port;
		u32 type;
		u32 mid;
	};
};

event {
	name = msg_recv;
	id = 0x44;
	fields := struct {
		u16 tid;
		u32 port;
		u32 mid;
		/* sender's pid */
		u16 spid;
	};
};

event {
	name = msg_respond;
	id = 0x45;
	fields := struct {
		u16 tid;
		u32 port;
		u32 mid;
	};
};

/* written last, at perf_stop: what the trace lost */
event {
	name = trace_stats;
	id = 0x46;
	fields := struct {
		/* events not recorded: their channel was full */
		u32 discarded;
		/* deferred waits not recorded: no free slot */
		u32 waits_dropped;
	};
};

